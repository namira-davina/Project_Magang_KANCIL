APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp: BalesOtomatis (https://api.balesotomatis.co.id/docs/) ---
BALESOTOMATIS_BASE_URL=https://api.balesotomatis.co.id/public/v1
# Kode Akses: member area > Integration > Kode Akses (Token)
BALESOTOMATIS_API_KEY=
# Dari: php artisan kancil:balesotomatis-info
BALESOTOMATIS_NUMBER_ID=
# nonresmi | waba
BALESOTOMATIS_CHANNEL=nonresmi
BALESOTOMATIS_LICENSES_KEY=
# String acak 40+ karakter; URL webhook = APP_URL/webhook/balesotomatis/<token>
BALESOTOMATIS_WEBHOOK_TOKEN=

# --- Mesin bot ---
# laravel       = menu rule-based + AI sendiri (MATIKAN "AI Powered" di BalesOtomatis agar tidak balas dobel)
# balesotomatis = AI BalesOtomatis menjawab, dashboard hanya mencatat & membalas manual
BOT_ENGINE=laravel
BOT_SESSION_TIMEOUT=30
BOT_HANDOFF_MINUTES=120
BOT_OUTSIDE_HOURS_NOTICE=true

# --- AI pihak ketiga (SumoPod, kompatibel OpenAI) ---
LLM_ENABLED=true
LLM_PROVIDER=sumopod
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-nano
LLM_REASONING_EFFORT=low
LLM_MAX_COMPLETION_TOKENS=2000
LLM_TIMEOUT=40
# verified = hanya FAQ Terverifikasi + Aktif | all = semua FAQ non-draf (dengan catatan "informasi umum")
LLM_FAQ_SCOPE=verified
LLM_DAILY_REQUEST_LIMIT=500
